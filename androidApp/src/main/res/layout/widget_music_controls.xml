<?xml version="1.0" encoding="utf-8"?>
<!-- PeekMusic widget controls: round skip buttons and a wide play button that turns into a rounded square while playing.
     RemoteViews inflates framework ImageViews, which cannot read AppCompat tint attributes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    tools:ignore="UseAppTint">

    <FrameLayout
        android:id="@+id/widget_prev_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:contentDescription="@string/previous"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_prev_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_transport_button_bg"
            android:tint="@color/widget_secondary_container" />

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_skip_previous"
            android:tint="@color/widget_on_secondary_container" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_play_pause_container"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="@string/play"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_play_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_play_pill_bg"
            android:tint="@color/widget_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_play"
                android:tint="@color/widget_on_primary" />

            <TextView
                android:id="@+id/widget_play_pause_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/play"
                android:textColor="@color/widget_on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_next_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:contentDescription="@string/next"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_next_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_transport_button_bg"
            android:tint="@color/widget_secondary_container" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_skip_next"
            android:tint="@color/widget_on_secondary_container" />
    </FrameLayout>
</LinearLayout>
