    <!-- Translators: Onboarding title when PeekMusic finds the library of an older PeekMusic 1.x install. -->
    <string name="peek_onboarding_migration_title">Narito na ang iyong PeekMusic 1.x library</string>
    <!-- Translators: Onboarding text that offers to move the PeekMusic 1.x library into this version. -->
    <string name="peek_onboarding_migration_description">Nahanap namin ang iyong PeekMusic 1.x library. Ilipat ang mga playlist, history, like at data ng library sa bersyong ito. Kung pumalya ang paglipat, maibabalik mo ang orihinal na database.</string>
    <!-- Translators: Onboarding text after the PeekMusic 1.x library and account were moved over. -->
    <string name="peek_onboarding_migration_complete_description">Handa na sa PeekMusic 2 ang iyong account, mga playlist, history, like at data ng library.</string>
    <!-- Translators: Onboarding text after the PeekMusic 1.x library was moved over, without a signed-in account. -->
    <string name="peek_onboarding_library_migrated_description">Handa na sa PeekMusic 2 ang iyong mga playlist, history, like at data ng library.</string>
    <!-- Translators: Hint on the last onboarding page. -->
    <string name="peek_onboarding_settings_hint">Buksan ang Settings mula sa menu sa kanang itaas para i-customize ang PeekMusic.</string>
    <!-- Translators: Badge on onboarding settings that PeekMusic 1.x did not have. -->
    <string name="peek_onboarding_new">Bago</string>
    <!-- Translators: Description on the first onboarding page. -->
    <string name="peek_onboarding_welcome_description">Ilang mabilis na pagpili, at magmumukha at tutunog ang PeekMusic ayon sa gusto mo.</string>
    <!-- Translators: Onboarding page with app language, content language and region. -->
    <string name="peek_onboarding_language_title">Wika at rehiyon</string>
    <string name="peek_onboarding_language_description">Piliin ang wika ng app at kung saan manggagaling ang iyong mga rekomendasyon.</string>
    <!-- Translators: Onboarding page about theme and colors. -->
    <string name="peek_onboarding_look_title">Gawin itong sa iyo</string>
    <string name="peek_onboarding_look_description">Light, dark o purong itim, na may kulay mula sa wallpaper o sa cover na tumutugtog.</string>
    <!-- Translators: Onboarding page about the player and mini player design. -->
    <string name="peek_onboarding_player_title">Player</string>
    <string name="peek_onboarding_player_description">Piliin ang disenyo ng player, background at itsura ng mini player.</string>
    <!-- Translators: Onboarding page about lyrics. Peek is the name of the lyrics line in the player; do not translate it. -->
    <string name="peek_onboarding_lyrics_title">Lyrics at Peek</string>
    <string name="peek_onboarding_lyrics_description">Ipinapakita ng Peek ang linyang kinakanta mismo sa player. Lumalabas sa ilalim nito ang mga salin at Latin na pagbaybay.</string>
    <!-- Translators: Onboarding page about canvas, animated covers and music videos. -->
    <string name="peek_onboarding_artwork_title">Canvas at mga video</string>
    <string name="peek_onboarding_artwork_description">Animated na cover, Canvas loop at music video sa kalidad na gusto mo.</string>
    <!-- Translators: Onboarding page about audio. -->
    <string name="peek_onboarding_sound_title">Tunog</string>
    <string name="peek_onboarding_sound_description">Kalidad ng audio, pantay na lakas ng tunog sa pagitan ng mga kanta at maayos na transition.</string>
    <!-- Translators: Onboarding page about content filters. -->
    <string name="peek_onboarding_content_title">Ang nakikita mo</string>
    <string name="peek_onboarding_content_description">Itago ang ayaw mong makita kailanman sa paghahanap, rekomendasyon at radyo.</string>
