    <string name="peek_onboarding_high_quality">Mataas na kalidad</string>
    <string name="peek_onboarding_high_quality_description">Canvas, animated na cover, video ng artist at music video sa 1080p. Mas maraming data ang gamit. Bawat isa ay maaaring ayusin nang hiwalay sa Settings.</string>
