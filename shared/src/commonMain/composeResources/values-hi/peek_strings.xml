    <!-- Translators: Onboarding title when PeekMusic finds the library of an older PeekMusic 1.x install. -->
    <string name="peek_onboarding_migration_title">आपकी PeekMusic 1.x लाइब्रेरी यहाँ है</string>
    <!-- Translators: Onboarding text that offers to move the PeekMusic 1.x library into this version. -->
    <string name="peek_onboarding_migration_description">हमें आपकी PeekMusic 1.x लाइब्रेरी मिली। प्लेलिस्ट, इतिहास, लाइक और लाइब्रेरी डेटा इस वर्ज़न में लाएँ। अगर माइग्रेशन फ़ेल हो जाए, तो आप मूल डेटाबेस वापस ला सकते हैं।</string>
    <!-- Translators: Onboarding text after the PeekMusic 1.x library and account were moved over. -->
    <string name="peek_onboarding_migration_complete_description">आपका अकाउंट, प्लेलिस्ट, इतिहास, लाइक और लाइब्रेरी डेटा PeekMusic 2 में तैयार है।</string>
    <!-- Translators: Onboarding text after the PeekMusic 1.x library was moved over, without a signed-in account. -->
    <string name="peek_onboarding_library_migrated_description">आपकी प्लेलिस्ट, इतिहास, लाइक और लाइब्रेरी डेटा PeekMusic 2 में तैयार है।</string>
    <!-- Translators: Hint on the last onboarding page. -->
    <string name="peek_onboarding_settings_hint">PeekMusic को अपने हिसाब से बनाने के लिए ऊपर दाईं ओर के मेन्यू से सेटिंग खोलें।</string>
    <!-- Translators: Badge on onboarding settings that PeekMusic 1.x did not have. -->
    <string name="peek_onboarding_new">नया</string>
    <!-- Translators: Description on the first onboarding page. -->
    <string name="peek_onboarding_welcome_description">कुछ तेज़ विकल्प चुनें और PeekMusic वैसा ही दिखेगा और सुनाई देगा जैसा आपको पसंद है।</string>
    <!-- Translators: Onboarding page with app language, content language and region. -->
    <string name="peek_onboarding_language_title">भाषा और क्षेत्र</string>
    <string name="peek_onboarding_language_description">ऐप की भाषा चुनें और यह कि आपके सुझाव कहाँ से आएँ।</string>
    <!-- Translators: Onboarding page about theme and colors. -->
    <string name="peek_onboarding_look_title">इसे अपना बनाएँ</string>
    <string name="peek_onboarding_look_description">लाइट, डार्क या पूरा काला, वॉलपेपर या चल रहे कवर के रंगों के साथ।</string>
    <!-- Translators: Onboarding page about the player and mini player design. -->
    <string name="peek_onboarding_player_title">प्लेयर</string>
    <string name="peek_onboarding_player_description">प्लेयर डिज़ाइन, बैकग्राउंड और मिनी प्लेयर का लुक चुनें।</string>
    <!-- Translators: Onboarding page about lyrics. Peek is the name of the lyrics line in the player; do not translate it. -->
    <string name="peek_onboarding_lyrics_title">बोल और Peek</string>
    <string name="peek_onboarding_lyrics_description">Peek गाई जा रही लाइन सीधे प्लेयर में दिखाता है। अनुवाद और रोमन लिपि उसके नीचे दिखते हैं।</string>
    <!-- Translators: Onboarding page about canvas, animated covers and music videos. -->
    <string name="peek_onboarding_artwork_title">Canvas और वीडियो</string>
    <string name="peek_onboarding_artwork_description">एनिमेटेड कवर, Canvas लूप और म्यूज़िक वीडियो आपकी पसंद की क्वालिटी में।</string>
    <!-- Translators: Onboarding page about audio. -->
    <string name="peek_onboarding_sound_title">साउंड</string>
    <string name="peek_onboarding_sound_description">ऑडियो क्वालिटी, गानों के बीच एक जैसी आवाज़ और स्मूद ट्रांज़िशन।</string>
    <!-- Translators: Onboarding page about content filters. -->
    <string name="peek_onboarding_content_title">आप क्या देखते हैं</string>
    <string name="peek_onboarding_content_description">जो आप खोज, सुझावों और रेडियो में कभी नहीं देखना चाहते, उसे छिपाएँ।</string>
    <!-- Translators: Onboarding switch that sets canvas, animated cover, artist video and music video quality to 1080p at once. -->
    <string name="peek_onboarding_high_quality">हाई क्वालिटी</string>
    <string name="peek_onboarding_high_quality_description">Canvas, एनिमेटेड कवर, आर्टिस्ट वीडियो और म्यूज़िक वीडियो 1080p में। ज़्यादा डेटा लगता है। हर एक को सेटिंग में अलग से बदला जा सकता है।</string>
