    <string name="peek_animated_covers_desktop_desc">उपलब्ध होने पर Apple Music से एनिमेटेड एल्बम कवर दिखाता है। ज़्यादा स्टोरेज और डेटा लगता है।</string>
    <string name="peek_listen_together_ios_user">iPhone यूज़र</string>
